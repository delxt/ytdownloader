# Comma-separated origins allowed to call the API (your frontend URL)
ALLOWED_ORIGINS=http://localhost:3000

# Limits (MAX_FILESIZE_MB=10240 is 10 GB; the server needs ~2.2x that in free temp space per download)
MAX_FILESIZE_MB=10240
INFO_TIMEOUT_SECONDS=30
DOWNLOAD_TIMEOUT_SECONDS=3600
RATE_LIMIT_INFO_PER_MINUTE=20
RATE_LIMIT_DOWNLOAD_PER_MINUTE=5
MAX_CONCURRENT_DOWNLOADS=3
# How long a finished download waits to be collected before it is deleted
JOB_TTL_SECONDS=1800

# Set to true when running behind a reverse proxy (nginx) so X-Forwarded-For is used for rate limiting
TRUST_PROXY=false

# JavaScript runtimes yt-dlp may use for YouTube (deno, node, bun, quickjs)
JS_RUNTIMES=deno,node

# Optional: path to ffmpeg binary or its folder. If empty, PATH is used, then the imageio-ffmpeg bundled binary.
FFMPEG_LOCATION=

# Optional: directory for temporary downloads (defaults to the system temp dir)
TEMP_DIR=
